<Window x:Class="ControllerApplication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Twitch Login" Height="300" Width="400">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Please choose an option to log in using your Twitch account:" Margin="0 0 0 10" TextWrapping="Wrap"/>

            <Button Content="Login with Default Browser" Width="200" HorizontalAlignment="Center" Click="LoginWithTwitch_Default_Click" Margin="0 10 0 0"/>
            <Button Content="Login with Private Browser" Width="200" HorizontalAlignment="Center" Click="LoginWithTwitch_Private_Click"/>

            <TextBlock Text="After logging in on Twitch, close the browser, and this window will update automatically." Margin="0 10 0 0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
